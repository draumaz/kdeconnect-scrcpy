post_install() {
  cat <<'MSG'
==> To start kdeconnect-scrcpy for your user:
      systemctl --user enable --now kdeconnect-scrcpy
==> To stop KDE Connect showing its own duplicate popups:
      kwriteconfig6 --file kdeconnect.notifyrc --group Event/notification --key Action ""
      pkill -x kdeconnectd   # it restarts automatically and picks up the change
==> Optional config: /usr/share/doc/kdeconnect-scrcpy/config.example.toml
      -> ~/.config/kdeconnect-scrcpy/config.toml
MSG
}

post_upgrade() {
  echo "==> Restart to pick up the new version: systemctl --user restart kdeconnect-scrcpy"
}
